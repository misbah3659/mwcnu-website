        window.saveAdminArticle = async function(event) {
            event.preventDefault();
            const editId = getEl('edit-article-id')?.value || '';
            const title = (getEl('admin-title')?.value || '').trim();
            const category = getEl('admin-category')?.value || 'Warta NU';
            const author = (getEl('admin-author')?.value || '').trim();
            const image = (getEl('admin-image')?.value || '').trim() || "https://images.unsplash.com/photo-1584551246679-0daf3d275d0f?auto=format&fit=crop&w=800&q=80";
            const rawContent = (getEl('admin-content')?.value || '').trim();
            const featured = !!getEl('admin-featured')?.checked;

            const todayStr = new Date().toLocaleDateString('id-ID', { day: 'numeric', month: 'long', year: 'numeric' });
            const payload = {
                title,
                category,
                author,
                image,
                featured,
                status: "published",
                excerpt: rawContent.substring(0, 135) + (rawContent.length > 135 ? "..." : ""),
                content: `<p>${rawContent.replace(/\n+/g, '</p><p>')}</p>`
            };

            try {
                if (db && currentUser && isCloudConnected) {
                    if (editId && !editId.startsWith('default-') && !editId.startsWith('local-')) {
                        await updateDoc(doc(db, 'artifacts', appId, 'public', 'data', 'articles', editId), payload);
                        showToast("Perubahan artikel berhasil disimpan!");
                    } else {
                        payload.date = todayStr;
                        payload.createdAt = Date.now();
                        await addDoc(collection(db, 'artifacts', appId, 'public', 'data', 'articles'), payload);
                        showToast("Berita baru berhasil diterbitkan!");
                    }
                } else {
                    if (featured) {
                        customArticles.forEach(a => a.featured = false);
                        defaultArticles.forEach(a => a.featured = false);
                    }
                    const existingIdx = customArticles.findIndex(a => String(a.id) === String(editId));
                    if (existingIdx !== -1) {
                        customArticles[existingIdx] = { ...customArticles[existingIdx], ...payload };
                    } else {
                        payload.id = 'local-' + Date.now();
                        payload.date = todayStr;
                        payload.createdAt = Date.now();
                        customArticles.unshift(payload);
                    }
                    writeLocalStorage(STORAGE_KEYS.ARTICLES, customArticles);
                    allArticles = [...customArticles, ...defaultArticles];
                    renderAllViews();
                    showToast("Berita berhasil disimpan dan tayang!");
                }
                closeAdminEditor();
            } catch (e) {
                payload.id = 'local-' + Date.now();
                payload.date = todayStr;
                payload.createdAt = Date.now();
                customArticles.unshift(payload);
                writeLocalStorage(STORAGE_KEYS.ARTICLES, customArticles);
                allArticles = [...customArticles, ...defaultArticles];
                renderAllViews();
                closeAdminEditor();
                showToast("Berita tersimpan!");
            }
        };

        window.approveArticle = async function(id) {
            if (String(id).startsWith('default-')) return;
            try {
                if (db && currentUser && isCloudConnected && !String(id).startsWith('local-')) {
                    await updateDoc(doc(db, 'artifacts', appId, 'public', 'data', 'articles', id), { status: 'published' });
                } else {
                    const target = customArticles.find(a => String(a.id) === String(id));
                    if (target) {
                        target.status = 'published';
                        writeLocalStorage(STORAGE_KEYS.ARTICLES, customArticles);
                        allArticles = [...customArticles, ...defaultArticles];
                        renderAllViews();
                    }
                }
                showToast("Artikel disetujui dan tayang di halaman utama!");
            } catch (e) {
                showToast("Gagal menayangkan artikel.");
            }
        };

        window.deleteArticleAdmin = async function(id) {
            if (String(id).startsWith('default-')) {
                showToast("Artikel bawaan sistem tidak dapat dihapus, namun bisa diedit atau ditimpa berita baru.");
                return;
            }
            try {
                if (db && currentUser && isCloudConnected && !String(id).startsWith('local-')) {
                    await deleteDoc(doc(db, 'artifacts', appId, 'public', 'data', 'articles', id));
                } else {
                    customArticles = customArticles.filter(a => String(a.id) !== String(id));
                    writeLocalStorage(STORAGE_KEYS.ARTICLES, customArticles);
                    allArticles = [...customArticles, ...defaultArticles];
                    renderAllViews();
                }
                showToast("Artikel berhasil dihapus.");
            } catch (e) {
                showToast("Gagal menghapus artikel.");
            }
        };

        // Navigasi 4 Tab Panel Admin
        window.switchAdminTab = function(tabName) {
            const panels = {
                articles: getEl('admin-tab-articles'),
                ticker: getEl('admin-tab-ticker'),
                contact: getEl('admin-tab-contact'),
                security: getEl('admin-tab-security')
            };
            const buttons = {
                articles: getEl('tab-btn-articles'),
                ticker: getEl('tab-btn-ticker'),
                contact: getEl('tab-btn-contact'),
                security: getEl('tab-btn-security')
            };

            Object.keys(panels).forEach(key => {
                if (panels[key]) {
                    panels[key].classList.toggle('hidden', key !== tabName);
                }
                if (buttons[key]) {
                    buttons[key].className = (key === tabName)
                        ? 'admin-tab-btn px-4 py-2 rounded-xl text-xs sm:text-sm font-bold bg-nu-900 text-white shadow-xs transition flex items-center gap-2'
                        : 'admin-tab-btn px-4 py-2 rounded-xl text-xs sm:text-sm font-semibold bg-white text-slate-700 border border-slate-200 hover:border-nu-700 transition flex items-center gap-2';
                }
            });
        };

        window.saveTickerText = async function() {
            const input = getEl('admin-ticker-input');
            const text = (input ? input.value : '').trim();
            if (!text) return;

            const updated = { ...siteSettings, tickerText: text };
            writeLocalStorage(STORAGE_KEYS.SETTINGS, updated);
            applySiteSettings(updated);

            try {
                if (db && currentUser && isCloudConnected) {
                    await setDoc(doc(db, 'artifacts', appId, 'public', 'data', 'settings', 'general'), { tickerText: text }, { merge: true });
                }
                showToast("Teks Sekilas Info berhasil diperbarui!");
            } catch (e) {
                showToast("Teks Sekilas Info tersimpan!");
            }
        };

        window.saveContactAndSocials = async function(event) {
            event.preventDefault();
            const rawWa = (getEl('setting-wa-number')?.value || '').trim();
            const cleanWa = normalizeWhatsAppNumber(rawWa);
            const phoneDisplay = (getEl('setting-phone-display')?.value || '').trim() || ('+' + cleanWa);

            const updatedSettings = {
                ...siteSettings,
                waNumber: cleanWa,
                phoneDisplay: phoneDisplay,
                youtubeUrl: normalizeSocialUrl(getEl('setting-youtube-url')?.value, 'https://www.youtube.com'),
                instagramUrl: normalizeSocialUrl(getEl('setting-instagram-url')?.value, 'https://instagram.com'),
                facebookUrl: normalizeSocialUrl(getEl('setting-facebook-url')?.value, 'https://facebook.com'),
                tiktokUrl: normalizeSocialUrl(getEl('setting-tiktok-url')?.value, 'https://tiktok.com'),
                email: (getEl('setting-email')?.value || '').trim() || defaultSettings.email,
                address: (getEl('setting-address')?.value || '').trim() || defaultSettings.address
            };

            writeLocalStorage(STORAGE_KEYS.SETTINGS, updatedSettings);
            applySiteSettings(updatedSettings);

            try {
                if (db && currentUser && isCloudConnected) {
                    await setDoc(doc(db, 'artifacts', appId, 'public', 'data', 'settings', 'general'), updatedSettings, { merge: true });
                }
                showToast("Pengaturan Kontak & Media Sosial berhasil disimpan!");
            } catch (e) {
                showToast("Pengaturan Kontak & Media Sosial tersimpan!");
            }
        };

        window.handleChangeAdminPassword = function(event) {
            event.preventDefault();
            const newPass = getEl('new-admin-password')?.value || '';
            const confirmPass = getEl('confirm-admin-password')?.value || '';

            if (newPass.length < 5) {
                showToast("Kata sandi minimal 5 karakter.");
                return;
            }
            if (newPass !== confirmPass) {
                showToast("Konfirmasi kata sandi tidak cocok!");
                return;
            }

            writeLocalStorage(STORAGE_KEYS.ADMIN_PASS, newPass);
            event.target.reset();
            showToast("Kata sandi admin berhasil diperbarui!");
        };

        function renderAdminTable() {
            const tbody = getEl('admin-articles-table');
            if (!tbody) return;

            const total = allArticles.length;
            const pendingCount = allArticles.filter(a => a.status === 'pending').length;
            const publishedCount = total - pendingCount;

            setText('stat-total', total);
            setText('stat-published', publishedCount);
            setText('stat-pending', pendingCount);

            tbody.innerHTML = '';
            allArticles.forEach(item => {
                const isPending = item.status === 'pending';
                const isDefault = String(item.id).startsWith('default-');
                const statusBadge = isPending
                    ? `<span class="px-2.5 py-1 rounded-full text-[11px] font-bold bg-amber-100 text-amber-800">Menunggu Moderasi</span>`
                    : `<span class="px-2.5 py-1 rounded-full text-[11px] font-bold bg-emerald-100 text-emerald-800">Tayang</span>`;

                const row = `
                <tr class="hover:bg-slate-50 transition">
                    <td class="py-3.5 px-4">
                        <p class="font-bold text-slate-800 line-clamp-1">${item.title}</p>
                        <p class="text-xs text-slate-500 mt-0.5">${item.author} • ${item.date}</p>
                    </td>
                    <td class="py-3.5 px-4">
                        <span class="text-xs font-semibold text-nu-900 bg-nu-50 px-2.5 py-1 rounded-lg">${item.category}</span>
                    </td>
                    <td class="py-3.5 px-4">${statusBadge}</td>
                    <td class="py-3.5 px-4 text-right space-x-1.5 whitespace-nowrap">
                        ${isPending ? `<button type="button" onclick="approveArticle('${item.id}')" class="px-2.5 py-1.5 bg-emerald-600 hover:bg-emerald-700 text-white text-xs font-bold rounded-lg" title="Setujui & Tayangkan"><i class="fas fa-check"></i> Tayangkan</button>` : ''}
                        <button type="button" onclick="openAdminEditor('${item.id}')" class="px-2.5 py-1.5 bg-slate-200 hover:bg-slate-300 text-slate-800 text-xs font-semibold rounded-lg" title="Edit Berita"><i class="fas fa-edit"></i></button>
                        ${!isDefault ? `<button type="button" onclick="deleteArticleAdmin('${item.id}')" class="px-2.5 py-1.5 bg-red-100 hover:bg-red-200 text-red-700 text-xs font-semibold rounded-lg" title="Hapus"><i class="fas fa-trash"></i></button>` : ''}
                    </td>
                </tr>
                `;
                tbody.innerHTML += row;
            });
        }

        // Salin Tautan & Toast Notification
        window.copyArticleLink = function() {
            const dummyInput = document.createElement('input');
            dummyInput.value = window.location.href;
            document.body.appendChild(dummyInput);
            dummyInput.select();
            document.execCommand('copy');
            document.body.removeChild(dummyInput);
            showToast("Tautan artikel berhasil disalin!");
        };

        let toastTimeout = null;
        window.showToast = function(message) {
            const toast = getEl('toast-notification');
            if (!toast) return;
            setText('toast-message', message);
            toast.classList.remove('hidden');
            if (toastTimeout) clearTimeout(toastTimeout);
            toastTimeout = setTimeout(() => {
                toast.classList.add('hidden');
            }, 3500);
        };

        // Inisialisasi saat halaman siap
        window.addEventListener('DOMContentLoaded', () => {
            initDate();
            applySiteSettings(siteSettings);
            renderAllViews();
            initCloudSync();
        });
    </script>
</body>
</html>
