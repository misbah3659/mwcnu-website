                closeSubmitModal();
                event.target.reset();
                showToast(isAdminLoggedIn ? "Berita berhasil diterbitkan!" : "Tulisan terkirim! Menunggu moderasi Admin Redaksi.");
            } catch (e) {
                newArticle.id = 'local-' + Date.now();
