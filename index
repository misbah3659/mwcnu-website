        // Inisialisasi Firebase Auth & Firestore (Dengan Fallback Otomatis ke localStorage)
        async function initCloudSync() {
            if (!firebaseConfig) {
                setText('storage-status-badge', 'Mode Penyimpanan Lokal Aktif');
                return;
            }

            try {
                const app = initializeApp(firebaseConfig);
                auth = getAuth(app);
                db = getFirestore(app);

                if (typeof __initial_auth_token !== 'undefined' && __initial_auth_token) {
                    await signInWithCustomToken(auth, __initial_auth_token);
                } else {
                    await signInAnonymously(auth);
                }

                onAuthStateChanged(auth, (user) => {
                    currentUser = user;
                    if (user) {
                        isCloudConnected = true;
                        const badge = getEl('storage-status-badge');
                        if (badge) {
                            badge.innerHTML = '<i class="fas fa-cloud-check mr-1"></i> Cloud & Lokal Tersinkron';
                        }
                        listenArticles();
                        listenSettings();
                    }
                });
            } catch (err) {
                isCloudConnected = false;
                setText('storage-status-badge', 'Mode Penyimpanan Lokal Aktif');
            }
        }

        function listenArticles() {
            if (!db || !currentUser) return;
            try {
                const colRef = collection(db, 'artifacts', appId, 'public', 'data', 'articles');
                onSnapshot(colRef, (snapshot) => {
                    const fetched = [];
                    snapshot.forEach(docSnap => {
                        fetched.push({ id: docSnap.id, ...docSnap.data() });
                    });
                    fetched.sort((a, b) => (b.createdAt || 0) - (a.createdAt || 0));
                    customArticles = fetched;
                    writeLocalStorage(STORAGE_KEYS.ARTICLES, customArticles);
                    allArticles = [...customArticles, ...defaultArticles];
                    renderAllViews();
                }, () => {
                    isCloudConnected = false;
                });
            } catch (e) {
                isCloudConnected = false;
            }
        }

        function listenSettings() {
            if (!db || !currentUser) return;
            try {
                const settingDoc = doc(db, 'artifacts', appId, 'public', 'data', 'settings', 'general');
                onSnapshot(settingDoc, (docSnap) => {
                    if (docSnap.exists()) {
                        const data = docSnap.data();
                        writeLocalStorage(STORAGE_KEYS.SETTINGS, { ...siteSettings, ...data });
                        applySiteSettings(data);
                    }
                }, () => {
                    isCloudConnected = false;
                });
            } catch (e) {
                isCloudConnected = false;
            }
        }

