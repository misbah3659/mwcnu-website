                excerpt: body.substring(0, 135) + (body.length > 135 ? "..." : ""),
                content: `<p>${body.replace(/\n+/g, '</p><p>')}</p>`
            };

            try {
                if (db && currentUser && isCloudConnected) {
                    await addDoc(collection(db, 'artifacts', appId, 'public', 'data', 'articles'), newArticle);
                } else {
                    newArticle.id = 'local-' + Date.now();
                    customArticles.unshift(newArticle);
                    writeLocalStorage(STORAGE_KEYS.ARTICLES, customArticles);
                    allArticles = [...customArticles, ...defaultArticles];
                    renderAllViews();
